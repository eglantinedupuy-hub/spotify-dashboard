# Copy this file to `.env` (and later `web/.env.local`) and fill in real values.
# NEVER commit the real file. NEVER paste these values into a chat.

# Spotify developer app (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback/spotify

# Last.fm API account (last.fm/api/account/create, "Non-commercial")
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_USERNAME=
